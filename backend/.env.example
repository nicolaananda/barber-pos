# ============================================
# Staycool Hairlab — Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# ============================================

# --- Server ---
NODE_ENV=production
PORT=3001

# --- Database (Prisma) ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/barber_pos"

# --- Database (Backup Service) ---
DB_NAME=barber_pos
DB_USER=root
DB_PASSWORD=
BACKUP_DIR=/root/backup/mysql-auto

# --- Authentication ---
JWT_SECRET=
EDIT_PIN=

# --- WhatsApp Gateway (Go-WA / WAHA) ---
WA_GATEWAY_URL=
WA_DEVICE_ID=
WA_GATEWAY_USER=
WA_GATEWAY_PASS=
WA_WEBHOOK_SECRET=
WAHA_API_KEY=

# --- Cloudflare R2 (File Storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- AI Analytics ---
AI_API_KEY=

# --- Booking Blackout (optional, format: YYYY-MM-DD) ---
# BLACKOUT_START=
# BLACKOUT_END=
