generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  password        String
  name            String
  photoUrl        String?
  role            String   @default("staff") // 'owner' | 'staff'
  status          String   @default("active")
  availability    String   @default("available") // 'available' | 'working' | 'offday'
  defaultOffDay   Int?     // 0=Sunday, 1=Monday, ..., 6=Saturday, null=no recurring off-day
  tokenVersion    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  openedShifts CashShift[]   @relation("OpenedShifts")
  closedShifts CashShift[]   @relation("ClosedShifts")
  transactions Transaction[]
  bookings     Booking[]
  offDays      OffDay[]
}

model BookingConfig {
  id               Int       @id @default(1)
  blackoutEnabled  Boolean   @default(false)
  blackoutStart    DateTime? @db.Date
  blackoutEnd      DateTime? @db.Date
  blackoutMessage  String?
  address          String?
  whatsappNumber   String?
  mapsUrl          String?
  instagramUrl     String?
  bookingDaysAhead Int       @default(3)
  regularOpenHour  Int       @default(11)
  fridayOpenHour   Int       @default(13)
  closeHour        Int       @default(22)
  headBarberId     Int?
  updatedAt        DateTime  @updatedAt
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model OffDay {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date // YYYY-MM-DD
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, date]) // Prevent duplicate off-days for same user/date
}

model Service {
  id              Int      @id @default(autoincrement())
  name            String
  price           Decimal  @db.Decimal(12, 2)
  commissionType  String   @default("percentage") // 'percentage' | 'flat'
  commissionValue Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  totalVisits Int      @default(0)
  lastVisit   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ⚡ Performance index
  @@index([lastVisit])  // Recent customer analysis
}

model CashShift {
  id            Int       @id @default(autoincrement())
  openedById    Int
  closedById    Int?
  startCash     Decimal   @db.Decimal(12, 2)
  actualEndCash Decimal?  @default(0) @db.Decimal(12, 2)
  totalRevenue  Decimal   @default(0) @db.Decimal(12, 2) // Calculated from transactions
  status        String    @default("open") // 'open' | 'closed'
  startTime     DateTime  @default(now())
  endTime       DateTime?
  notes         String?

  // Relations
  openedBy User  @relation("OpenedShifts", fields: [openedById], references: [id])
  closedBy User? @relation("ClosedShifts", fields: [closedById], references: [id])

  @@index([status])
}

model Transaction {
  id            Int      @id @default(autoincrement())
  invoiceCode   String   @unique
  barberId      Int
  customerName  String?
  customerPhone String?
  items         Json // Stores array of {name, price, qty}
  totalAmount   Decimal  @db.Decimal(12, 2)
  paymentMethod String   @default("cash") // 'cash' | 'qris'
  date          DateTime @default(now())

  // Relations
  barber User @relation(fields: [barberId], references: [id])

  // ⚡ Performance indexes
  @@index([barberId, date])  // Barber performance reports
  @@index([date])             // Daily/monthly reports
  @@index([customerPhone])    // Customer history lookup
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("operational")
  date        DateTime @default(now())

  @@index([date])
}

model Payroll {
  id              Int      @id @default(autoincrement())
  barberId        Int
  period          String // YYYY-MM
  totalServices   Int
  totalCommission Decimal  @db.Decimal(12, 2)
  baseSalary      Decimal  @default(0) @db.Decimal(12, 2) // If any
  bonuses         Decimal  @default(0) @db.Decimal(12, 2)
  deductions      Decimal  @default(0) @db.Decimal(12, 2) // Kasbon etc
  totalPayout     Decimal  @db.Decimal(12, 2)
  status          String   @default("draft") // draft, paid
  generatedAt     DateTime @default(now())

  @@index([period, status])
  @@index([barberId])
}

model Booking {
  id            Int      @id @default(autoincrement())
  barberId      Int
  barber        User     @relation(fields: [barberId], references: [id])
  customerName  String
  customerPhone String
  bookingDate   DateTime
  timeSlot      String   // e.g., "14:00 - 15:00"
  serviceId     Int?     // Selected Service ID
  serviceName   String?  // Snapshot of service name
  servicePrice  Decimal? @db.Decimal(12, 2) // Snapshot of service price
  status        String   @default("pending") // pending, confirmed, cancelled, completed
  activeSlotKey String?  @unique // barberId:YYYY-MM-DD:timeSlot for pending/confirmed only
  paymentProof  String?  // URL/Path to uploaded evidence
  transactionId Int?     @unique // Link to the transaction that fulfilled this booking
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

// Tracking reschedule history
  rescheduledFrom      DateTime?
  rescheduledFromSlot  String?
  rescheduledAt        DateTime?
  rescheduledByAdminId Int?
  rescheduleCount      Int      @default(0)

  // ⚡ Performance indexes for common queries
  @@index([barberId, bookingDate, status]) // Most frequent query pattern
  @@index([customerPhone])                  // Customer lookup
  @@index([status, bookingDate])            // Status filtering with date
  @@index([bookingDate])                    // Date-based queries
}

model Capital {
  id          Int      @id @default(autoincrement())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @default("injection") // 'injection'
  date        DateTime @default(now())

  @@index([date])
}
